BLOG_ENV=development # production

GEMINI_API_KEY=your-gemini-api-key-here
LINKEDIN_ACCESS_TOKEN=your-60-day-oauth-token-here
LINKEDIN_PERSON_ID=your-linkedin-numeric-id-here
# App credentials (LinkedIn app -> Auth tab), used by tools/linkedin/rotate_token.py
LINKEDIN_CLIENT_ID=your-linkedin-client-id-here
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret-here
# Only issued to apps approved for programmatic refresh; written by rotate_token.py
# LINKEDIN_REFRESH_TOKEN=
# IANA timezone for which calendar day counts as "today" (default UTC if unset)
# LINKEDIN_POST_DATE_TZ=America/Los_Angeles
# X API credentials
TWITTER_API_KEY=your-x-api-key-here
TWITTER_API_SECRET=your-x-api-secret-here
TWITTER_ACCESS_TOKEN=your-x-access-token-here
TWITTER_ACCESS_TOKEN_SECRET=your-x-access-token-secret-here
# IANA timezone for which calendar day counts as "today" (default UTC if unset)
# TWITTER_POST_DATE_TZ=America/Los_Angeles
# GA4 measurement ID (optional; defaults to site ID if unset)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXX
